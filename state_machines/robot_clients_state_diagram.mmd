stateDiagram-v2
    direction LR

    [*] --> Server

    state "Server" as Server {
        [*] --> ServerReady
        state "Waiting for client connections" as ServerReady
        state "Accept connection and spawn client thread" as ServerAccept
        state "Forward MESSAGE / MESSAGE_RECEIVED" as ServerForward

        ServerReady --> ServerAccept: accept()
        ServerAccept --> ServerReady: client thread running
        ServerReady --> ServerForward: client thread recv line
        ServerForward --> ServerReady: send ACK / forward payload
    }

    state "Waiter client" as WaiterClient {
        [*] --> WaiterIdle
        state "Idle / waiting for chef prompt" as WaiterIdle
        state "Search green" as WaiterSearchGreen
        state "Align to green" as WaiterAlignGreen
        state "Search red" as WaiterSearchRed
        state "Approach red" as WaiterApproachRed
        state "Mission complete" as WaiterDone

        WaiterIdle --> WaiterSearchGreen: receive asking for green
        WaiterSearchGreen --> WaiterAlignGreen: green detected
        WaiterAlignGreen --> WaiterSearchRed: close to green
        WaiterSearchRed --> WaiterApproachRed: green finished / mission step 12
        WaiterApproachRed --> WaiterDone: red reached for 3 s
        WaiterDone --> WaiterDone: stop motors

        WaiterSearchGreen --> WaiterSearchGreen: turn toward green
        WaiterAlignGreen --> WaiterAlignGreen: drive forward
        WaiterSearchRed --> WaiterSearchRed: turn toward red
        WaiterApproachRed --> WaiterApproachRed: drive toward red
    }

    state "Chef client" as ChefClient {
        [*] --> ChefIdle
        state "Idle / processing incoming messages" as ChefIdle
        state "Send next instruction" as ChefSendInstruction
        state "Wait for MESSAGE_RECEIVED" as ChefWaitAck
        state "Finish order" as ChefFinish

        ChefIdle --> ChefSendInstruction: incoming found / request text
        ChefSendInstruction --> ChefWaitAck: send MESSAGE green/tomato/cucumber
        ChefWaitAck --> ChefIdle: receive MESSAGE_RECEIVED
    }

    Server --> WaiterClient: forward MESSAGE asking for green / green / tomato / cucumber
    Server --> ChefClient: forward MESSAGE found / other text
    WaiterClient --> Server: send MESSAGE found
    ChefClient --> Server: send MESSAGE green or MESSAGE_RECEIVED
    ChefClient --> WaiterClient: forward instruction or confirmation
